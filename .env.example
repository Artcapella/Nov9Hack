# Elasticsearch Cloud Serverless Vector Database project
ELASTICSEARCH_URL=https://your-project.es.us-central1.gcp.cloud.es.io
ELASTICSEARCH_API_KEY=replace_me
ELASTICSEARCH_INDEX_PREFIX=network
# Leave blank to use the Serverless semantic_text default; set to an EIS endpoint ID if provisioned.
ELASTIC_INFERENCE_ID=
KIBANA_URL=https://your-project.kb.us-central1.gcp.cloud.es.io

# Public URL used in attendee and temporary connection QR codes.
PUBLIC_BASE_URL=http://localhost:8000
DEMO_EVENT_ID=cnh-2026
PROFILE_EXPIRY_HOURS=8

# Optional: enables generated RAG answers. Retrieval works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Dash0 OTLP HTTP endpoint and headers. Example header syntax: Authorization=Bearer%20token
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=network-concierge

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required for encrypted private contacts in deployed environments.
CONTACT_ENCRYPTION_KEY=
