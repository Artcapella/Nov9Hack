# Local UI mode: leave both Elastic values blank. Production requires Elastic.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_PREFIX=network
# v2 already exists with the prototype schema; this implementation uses new aliases.
ELASTIC_SCHEMA_VERSION=v3
ELASTIC_INFERENCE_ID=.jina-embeddings-v5-text-small
# Cross-encoder for concierge evidence (text_similarity_reranker). Leave empty to keep plain RRF order.
ELASTIC_RERANK_INFERENCE_ID=.jina-reranker-v3
# Bootstrap with an admin key; runtime keys should not manage mappings.
ELASTIC_BOOTSTRAP_ON_START=false
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000
DEMO_EVENT_ID=cnh-2026
ENVIRONMENT=development
PROFILE_EXPIRY_HOURS=8
SESSION_HOURS=24
DRAFT_MINUTES=20
# Required for any Elasticsearch-backed runtime. Keep stable across API/worker restarts.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTACT_ENCRYPTION_KEY=
# Organizer-only Ops tab (aggregates only). Required whenever Elasticsearch is enabled; 16+ chars.
# python -c "import secrets; print(secrets.token_urlsafe(24))"
OPS_TOKEN=

# Serverless: the Elasticsearch URL with .es. replaced by .kb.
KIBANA_URL=
AGENT_BUILDER_API_KEY=
AGENT_BUILDER_AGENT_ID=network-concierge
# Enable after provisioning and executing the event-scoped tools in Kibana.
AGENT_BUILDER_ENABLED=false

# Exact source hosts, JSON array. Keep empty until acquisition permission is established.
RESUME_SOURCE_HOSTS=[]
IMPORT_MIN_INTERVAL_SECONDS=1
WORKER_POLL_SECONDS=3
WORKER_LEASE_SECONDS=180
WORKER_MAX_ATTEMPTS=3

# OTLP/HTTP base, WITHOUT a signal path; distinct trace/metric paths are appended.
DASH0_OTLP_HTTP_BASE=https://ingress.us-west-2.aws.dash0.com
DASH0_AUTH_TOKEN=
DASH0_DATASET=default
OTEL_SERVICE_NAME=network-api
APP_VERSION=dev
# Alternative standard OTLP settings (headers use URL-encoded values).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Security. The API gets the scoped keys from scripts/provision_keys.py (.env.api); the admin key above stays local.
# Behind a trusted edge that overwrites it, name the header carrying the real client IP (Cloudflare: cf-connecting-ip).
CLIENT_IP_HEADER=
RATE_LIMITS_ENABLED=true
# api | worker. The worker runs without CONTACT_ENCRYPTION_KEY, OPS_TOKEN and Agent Builder settings.
NETWORK_ROLE=api
